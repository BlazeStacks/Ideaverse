# ---------------------------------------------------------------------------
# Repository root ignores.
#
# This file stays deliberately minimal so it cannot interfere with the
# independently developed backend. Application-specific ignores live with the
# code that owns them:
#   frontend/.gitignore  (frontend developer)
#   backend/.gitignore   (backend developer)
# ---------------------------------------------------------------------------

# Dependencies and build output
node_modules/
dist/
build/
.vercel/

# Local environment files (real values are never committed).
# .env.example files ARE committed on purpose.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.local

.freebuff/
