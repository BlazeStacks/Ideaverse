# ---------------------------------------------------------------------------
# CivicFix AI backend environment. Copy to backend/.env (git-ignored) and fill
# in real values there. Never commit a real key.
# ---------------------------------------------------------------------------

# Required. Groq API key used for image analysis (https://console.groq.com/keys).
GROQ_API_KEY=your_groq_api_key_here

# Optional. Comma-separated browser origins allowed to call this API.
# Defaults to the Vite dev server and preview ports on localhost / 127.0.0.1.
# Add the deployed frontend origin for production; do not use "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Groq model id. Defaults to qwen/qwen3.8-27b, which Groq lists as a
# PREVIEW model (may change or be withdrawn at short notice). It must accept
# image input and JSON mode.
# GROQ_MODEL=qwen/qwen3.8-27b

# Optional. Max tokens the model may produce. qwen/qwen3.8-27b "thinks" by
# default and thinking tokens count towards this limit. Default: 6000.
# GROQ_MAX_COMPLETION_TOKENS=6000

# Optional. Set to "none" for the faster non-thinking mode if answers are cut
# off. Allowed: none, default, low, medium, high. Unset = model default.
# GROQ_REASONING_EFFORT=none

# Optional. Demo-grade limits (in memory, single process).
# MAX_CONCURRENT_ANALYSES=2
# RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Supabase (saved reports). Backend-only: never put these in frontend code.
# Supabase Dashboard -> Project Settings -> API (or "API Keys").
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# SECRET key (new "sb_secret_..." key) or legacy service_role key. NOT the
# publishable/anon key. It bypasses row-level security, so keep it private.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
