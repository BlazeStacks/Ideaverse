# ---------------------------------------------------------------------------
# CivicFix AI — frontend environment (copy to .env.local for local development)
#
# Vite only exposes variables prefixed with VITE_ to browser code.
# NEVER put privileged secrets here (Groq API keys, database service-role keys,
# passwords). The AI backend owns those. This frontend only needs the base URL
# of the separately developed backend.
# ---------------------------------------------------------------------------

# Base URL of the CivicFix AI backend (FastAPI), without a trailing slash.
# The backend is developed independently and may not be running yet.
VITE_API_URL=http://localhost:8000
