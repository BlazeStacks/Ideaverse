# ---------------------------------------------------------------------------
# CivicFix AI — frontend environment (copy to .env.local for local development)
#
# Vite only exposes variables prefixed with VITE_ to browser code, and inlines
# them into the public bundle. NEVER put secrets here (the Groq API key lives
# in backend/.env only). This frontend only needs the backend base URL.
# ---------------------------------------------------------------------------

# Base URL of the CivicFix AI backend (FastAPI), without a trailing slash.
# The backend must allow this app's origin in its CORS_ORIGINS setting.
VITE_API_URL=http://localhost:8000
